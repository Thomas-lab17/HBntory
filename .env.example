# Copy this file to .env before starting the stack.
POSTGRES_DB=hbntory
POSTGRES_USER=hbntory
POSTGRES_PASSWORD=root

APP_ENV=development
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=30
# Comptes créés dans la seed uniquement en développement.
DEMO_ADMIN_PASSWORD=admin
DEMO_COMMON_PASSWORD=common
BACKOFFICE_PORT=8000
AI_SERVICE_PORT=8001
PRODUCT_MCP_PORT=8002
CLIENT_WEB_PORT=8080

# External product catalog (empty = compose default external-products-api).
PRODUCT_API_URL=

# Shared secret for AI → backoffice internal read API.
INTERNAL_API_KEY=dev-internal-key
