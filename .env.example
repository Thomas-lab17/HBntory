# Copy to .env and fill in real values:  cp .env.example .env
# Required — DeepSeek API key (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=sk-your-deepseek-key
# Optional — LLM model (deepseek-chat supports tool calling)
DEEPSEEK_MODEL=deepseek-chat

# Backoffice API (optional overrides)
SECRET_KEY=change-me-in-production
SERVICE_API_KEY=dev-service-key
ADMIN_PASSWORD=admin
